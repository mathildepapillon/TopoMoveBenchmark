% ======================================================================
% !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
% !!  PLACEHOLDER STYLE FILE -- NOT THE OFFICIAL ICLR 2027 STYLE     !!
% !!  SWAP FOR THE OFFICIAL STYLE FILE WHEN RELEASED.                !!
% !!  This file only approximates the ICLR conference format         !!
% !!  (10pt, letterpaper, running header, anonymous author block)    !!
% !!  so that the skeleton compiles today. Numbers such as page      !!
% !!  budget, exact margins, and the bibliography style WILL differ  !!
% !!  from the official release.                                     !!
% !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
% ======================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iclr2027_conference}[2026/08/16 v0.1 PLACEHOLDER ICLR 2027 conference style]

% ----------------------------------------------------------------------
% Page geometry (approximating ICLR: letterpaper, 5.5in x 9in text block)
% ----------------------------------------------------------------------
\setlength{\paperwidth}{8.5in}
\setlength{\paperheight}{11in}
\setlength{\textwidth}{5.5in}
\setlength{\textheight}{9.0in}
\setlength{\topmargin}{-0.5in}
\setlength{\headheight}{12pt}
\setlength{\headsep}{25pt}
\setlength{\footskip}{30pt}
\setlength{\oddsidemargin}{0.5in}
\setlength{\evensidemargin}{0.5in}
\setlength{\marginparwidth}{1.1in}
\setlength{\marginparsep}{7pt}
\setlength{\parindent}{15pt}
\setlength{\parskip}{0pt}

% ----------------------------------------------------------------------
% Running header: "Under review as a conference paper at ICLR 2027"
% ----------------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small Under review as a conference paper at ICLR 2027}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
% First page uses the same header (matches ICLR under-review format).
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\small Under review as a conference paper at ICLR 2027}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}}

% ----------------------------------------------------------------------
% Final-copy toggle (de-anonymize). Default: anonymous (under review).
% ----------------------------------------------------------------------
\newif\ificlrfinal
\iclrfinalfalse
\newcommand{\iclrfinalcopy}{\iclrfinaltrue}

% ----------------------------------------------------------------------
% Title block: left-aligned title, anonymous author block when not final
% ----------------------------------------------------------------------
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \@maketitle
  \endgroup
  \setcounter{footnote}{0}%
  \thispagestyle{plain}%
}
\def\@maketitle{%
  \vskip 0.1in
  {\raggedright\LARGE\bfseries\@title\par}%
  \vskip 0.2in
  {\raggedright\normalsize
    \ificlrfinal
      \@author
    \else
      \textbf{Anonymous authors}\\
      Paper under double-blind review%
    \fi\par}%
  \vskip 0.25in
}

% ----------------------------------------------------------------------
% Abstract environment (centered heading, indented body)
% ----------------------------------------------------------------------
\renewenvironment{abstract}{%
  \vskip 0.075in
  \centerline{\large\scshape Abstract}%
  \vspace{0.5ex}%
  \begin{quote}}%
 {\par\end{quote}\vskip 1ex}

% ----------------------------------------------------------------------
% Section headings in small caps (ICLR look)
% ----------------------------------------------------------------------
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
  {1.5ex \@plus 0.3ex \@minus 0.2ex}%
  {\large\scshape\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
  {0.8ex \@plus 0.2ex}%
  {\normalsize\scshape\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}%
  {0.5ex \@plus 0.2ex}%
  {\normalsize\bfseries\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}%
  {-1em}%
  {\normalsize\bfseries}}

% ----------------------------------------------------------------------
% Misc typographic defaults
% ----------------------------------------------------------------------
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}
\flushbottom
\sloppy

\endinput
% end of iclr2027_conference.sty (PLACEHOLDER)
